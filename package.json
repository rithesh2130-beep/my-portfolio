{
  "name": "portfolio-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "pnpm -C client install && pnpm -C server install",
    "dev:client": "pnpm -C client dev",
    "dev:server": "pnpm -C server dev",
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "build": "pnpm -C client build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
